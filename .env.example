# 이 파일을 복사해서 .env 로 만들고 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 에 있어 깃허브에 절대 올라가지 않습니다.

# --- 글 생성 AI (둘 중 하나만) ---
# 무료: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 유료: https://console.anthropic.com  (무료로 쓸 거면 비워두세요)
ANTHROPIC_API_KEY=

# --- 뉴스 수집 (무료) ---
# https://developers.naver.com/apps/#/register
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 스레드 발행 ---
# https://developers.facebook.com
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# 카드 하단에 넣을 계정명 (예: @commercial.re)
THREADS_ACCOUNT_HANDLE=

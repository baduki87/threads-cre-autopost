# 이 파일을 복사해서 .env 로 만들고 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 에 있어 깃허브에 절대 올라가지 않습니다.

# --- 글 생성 AI (둘 중 하나만) ---
# 무료: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 유료: https://console.anthropic.com  (무료로 쓸 거면 비워두세요)
ANTHROPIC_API_KEY=

# --- 뉴스 수집 (무료) ---
# https://developers.naver.com/apps/#/register
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 스레드 발행 ---
# https://developers.facebook.com
# 권한 3개 필요: threads_basic, threads_content_publish, threads_manage_insights
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# --- 노션 (초안 승인 + 메모 입력) ---
# 통합 토큰: https://www.notion.so/my-integrations 에서 발급
NOTION_TOKEN=
# DB 는 이미 만들어져 있다 (스레드 자동 발행)
NOTION_DB_ID=bcb85698aaa5474e9c4d5a5f5716dc1f

# --- 카카오톡 알림 (초안 알림 + 실패 알림) ---
# 발급: ./.venv/bin/python tools/kakao_setup.py
KAKAO_REST_API_KEY=
KAKAO_REFRESH_TOKEN=

# 카드 하단에 넣을 계정명 (예: @pro_konwoo)
THREADS_ACCOUNT_HANDLE=
